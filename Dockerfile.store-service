# =========================
# Stage 1: Build
# =========================
FROM python:3.14-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /usr/local/bin/uv

# Byte-compile at build time, copy instead of hard-linking between the cache and the
# virtual environment, and use the image's Python instead of downloading one.
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependencies first, so this layer is reused while only the code changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY README.md ./
COPY common common
COPY proto proto
COPY store_service store_service
COPY payment_service payment_service
RUN uv sync --frozen --no-dev --no-editable

# =========================
# Stage 2: Runtime
# =========================
FROM python:3.14-slim

RUN apt-get update && apt-get install -y --no-install-recommends tzdata && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system app && useradd --system --gid app --no-create-home app

WORKDIR /app

COPY --from=builder /app/.venv ./.venv
COPY migrations ./migrations
COPY docs ./docs

RUN mkdir -p /app/uploads && chown -R app:app /app

ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1

USER app

EXPOSE 8080

ENTRYPOINT ["store-service"]
